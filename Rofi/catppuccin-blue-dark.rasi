* {
    /* Paleta Catppuccin Mocha */
    rosewater: #f5e0dc;
    flamingo:  #f2cdcd;
    pink:      #f5c2e7;
    mauve:     #cba6f7;
    red:       #f38ba8;
    maroon:    #eba0ac;
    peach:     #fab387;
    yellow:    #f9e2af;
    green:     #a6e3a1;
    teal:      #94e2d5;
    sky:       #89dceb;
    sapphire:  #74c7ec;
    blue:      #89b4fa;
    lavender:  #b4befe;
    text:      #cdd6f4;
    subtext1:  #bac2de;
    subtext0:  #a6adc8;
    overlay2:  #9399b2;
    overlay1:  #7f849c;
    overlay0:  #6c7086;
    surface2:  #585b70;
    surface1:  #45475a;
    surface0:  #313244;
    base:      #1e1e2e;
    mantle:    #181825;
    crust:     #11111b;

    background-color: transparent;
    font: "Space Grotesk Regular 11";
}

window {
    width:            500px;
    background-color: @base;
    border:           2px;
    border-color:     @blue;
    border-radius:    12px;
}

mainbox {
    children:         [ inputbar, listview ];
    spacing:          0px;
}

inputbar {
    background-color: @surface0;
    children:         [ prompt, entry ];
    padding:          15px;
}

prompt {
    text-color:       @blue;
    padding:          0px 10px 0px 0px;
}

entry {
    text-color:       @text;
    placeholder:      "Pesquisar...";
    placeholder-color: @overlay0;
}

listview {
    padding:          10px;
    lines:            8;
    columns:          1;
    scrollbar:        false;
    spacing:          5px;
    dynamic:          true;
}

element {
    padding:          10px;
    border-radius:    8px;
    text-color:       @text;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected {
    background-color: @surface1;
    text-color:       @blue;
}
